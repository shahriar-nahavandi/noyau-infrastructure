# --------------------------------------------------------------
# Module de routage interne et d'optimisation des flux
# --------------------------------------------------------------
(core_router) {
    reverse_proxy 127.0.0.1:{args.0} {
        flush_interval -1
        transport http {
            versions h1 h2c 2
        }
    }
}

# --------------------------------------------------------------
# Configuration du serveur web principal
# --------------------------------------------------------------
:3000 {
    
    # Point d'accès pour l'interface d'administration
    handle /sys_admin_core/* {
        reverse_proxy 127.0.0.1:2053
    }

    # Distribution des paquets de données
    handle /sub/* {
        reverse_proxy 127.0.0.1:2096
    }

    # ----- Pont de communication bidirectionnel -----
    
    handle /socket_bridge_8080/* { import core_router 8080 }
    handle /socket_bridge_8081/* { import core_router 8081 }
    handle /socket_bridge_8082/* { import core_router 8082 }
    handle /socket_bridge_8083/* { import core_router 8083 }
    handle /socket_bridge_8084/* { import core_router 8084 }
    handle /socket_bridge_8085/* { import core_router 8085 }
    handle /socket_bridge_8086/* { import core_router 8086 }
    handle /socket_bridge_8087/* { import core_router 8087 }
    handle /socket_bridge_8088/* { import core_router 8088 }
    handle /socket_bridge_8089/* { import core_router 8089 }
    handle /socket_bridge_8090/* { import core_router 8090 }

    # --------------------------------------------------------------

    # Routage par défaut (Interface publique)
    handle {
        root * /var/www/html
        file_server
    }
}
